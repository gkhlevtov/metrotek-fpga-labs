set_global_assignment -name TIMING_ANALYZER_MULTICORNER_ANALYSIS ON
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL
set_location_assignment PIN_C6 -to clk_125m
set_instance_assignment -name CURRENT_STRENGTH_NEW 12MA -to clk_125m
set_instance_assignment -name IO_STANDARD "2.5 V" -to clk_125m
set_instance_assignment -name VIRTUAL_PIN ON -to rst_i
set_instance_assignment -name VIRTUAL_PIN ON -to offset_i
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_instance_assignment -name VIRTUAL_PIN ON -to snk_base_data_i
set_instance_assignment -name VIRTUAL_PIN ON -to snk_base_valid_i
set_instance_assignment -name VIRTUAL_PIN ON -to snk_base_startofpacket_i
set_instance_assignment -name VIRTUAL_PIN ON -to snk_base_endofpacket_i
set_instance_assignment -name VIRTUAL_PIN ON -to snk_base_empty_i
set_instance_assignment -name VIRTUAL_PIN ON -to snk_base_ready_o
set_instance_assignment -name VIRTUAL_PIN ON -to snk_to_insert_data_i
set_instance_assignment -name VIRTUAL_PIN ON -to snk_to_insert_valid_i
set_instance_assignment -name VIRTUAL_PIN ON -to snk_to_insert_startofpacket_i
set_instance_assignment -name VIRTUAL_PIN ON -to snk_to_insert_endofpacket_i
set_instance_assignment -name VIRTUAL_PIN ON -to snk_to_insert_empty_i
set_instance_assignment -name VIRTUAL_PIN ON -to snk_to_insert_ready_o
set_instance_assignment -name VIRTUAL_PIN ON -to src_data_o
set_instance_assignment -name VIRTUAL_PIN ON -to src_valid_o
set_instance_assignment -name VIRTUAL_PIN ON -to src_startofpacket_o
set_instance_assignment -name VIRTUAL_PIN ON -to src_endofpacket_o
set_instance_assignment -name VIRTUAL_PIN ON -to src_empty_o
set_instance_assignment -name VIRTUAL_PIN ON -to src_ready_i
